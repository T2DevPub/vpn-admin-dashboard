<!DOCTYPE html>
<html>
<head>
    <title>Devices | VPN Admin</title>
    <link rel="icon" type="image/png" href="/images/t2vpn_icon.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <nav class="bg-[#424A5C] text-white p-4 flex justify-between items-center shadow">
        <div class="flex items-center space-x-3">
            <img src="/images/t2VPN.png" alt="t2VPN Logo" class="h-8 bg-white p-1 rounded">
            <span class="font-bold text-xl">Admin Dashboard</span>
        </div>
        <div>
            <a href="/dashboard" class="mr-4 hover:text-gray-300">Dashboard</a>
            <a href="/servers" class="mr-4 hover:text-gray-300">Servers</a>
            <a href="/devices" class="mr-4 font-bold border-b-2">Devices</a>
            <a href="/ads" class="mr-4 hover:text-gray-300">Ads</a>
            <a href="/settings" class="mr-4 hover:text-gray-300">Settings</a>
            <a href="/logout" class="bg-[#2D3340] hover:bg-[#1A1F29] px-3 py-1 rounded transition">Logout</a>
        </div>
    </nav>

    <div class="p-8 max-w-7xl mx-auto">
        <h1 class="text-2xl font-bold mb-6 text-gray-700">Device Bandwidth Usage (Today)</h1>

        <div class="bg-white rounded shadow overflow-hidden">
            <table class="w-full text-left">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="p-4 font-semibold text-gray-600">Device ID (Anonymous)</th>
                        <th class="p-4 font-semibold text-gray-600">Bandwidth Consumed Today</th>
                        <th class="p-4 font-semibold text-gray-600">Throttle Status</th>
                        <th class="p-4 font-semibold text-gray-600">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% devices.forEach(device => { %>
                    <tr class="border-b hover:bg-gray-50 transition">
                        <td class="p-4 font-mono text-sm text-gray-600">
                            <%= device.id %>
                        </td>
                        <td class="p-4 font-bold text-gray-800">
                            <%= device.consumedDisplay %>
                        </td>
                        <td class="p-4">
                            <% if(device.isThrottled) { %>
                                <span class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-bold uppercase tracking-wider">Throttled (1 Mbps)</span>
                            <% } else { %>
                                <span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold uppercase tracking-wider">Normal</span>
                            <% } %>
                        </td>
                        <td class="p-4">
                            <form action="/devices/reset/<%= device.id %>" method="POST">
                                <button type="submit" onclick="return confirm('Reset bandwidth quota for this device?');" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1 rounded shadow text-sm font-medium transition">
                                    Reset Quota
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                    <% if(devices.length === 0) { %>
                        <tr><td colspan="4" class="p-8 text-center text-gray-500 italic">No devices have consumed bandwidth today yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>