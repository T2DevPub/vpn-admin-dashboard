<!DOCTYPE html>
<html>
<head>
    <title>Devices | VPN Admin</title>
    <link rel="icon" type="image/png" href="/images/t2vpn_icon.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <nav class="bg-[#424A5C] text-white p-4 flex justify-between items-center shadow">
        <div class="flex items-center space-x-3">
            <img src="/images/t2VPN.png" alt="t2VPN Logo" class="h-8 bg-white p-1 rounded">
            <span class="font-bold text-xl">Admin Dashboard</span>
        </div>
        <div>
            <a href="/dashboard" class="mr-4 hover:text-gray-300">Dashboard</a>
            <a href="/servers" class="mr-4 hover:text-gray-300">Servers</a>
            <a href="/devices" class="mr-4 font-bold border-b-2">Devices</a>
            <a href="/ads" class="mr-4 hover:text-gray-300">Ads</a>
            <a href="/settings" class="mr-4 hover:text-gray-300">Settings</a>
            <a href="/network" class="mr-4 hover:text-gray-300">Network</a>
            <a href="/logout" class="bg-[#2D3340] hover:bg-[#1A1F29] px-3 py-1 rounded transition">Logout</a>
        </div>
    </nav>

    <div class="p-8 max-w-7xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-700">Device Bandwidth Usage</h1>

            <!-- Filters -->
            <form method="GET" action="/devices" class="flex space-x-4 items-center bg-white p-3 rounded shadow">
                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase">Date</label>
                    <input type="date" name="date" value="<%= selectedDate %>" class="block w-full mt-1 border-gray-300 rounded-md shadow-sm focus:ring-[#424A5C] focus:border-[#424A5C] sm:text-sm p-2 border">
                </div>
                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase">Status</label>
                    <select name="status" class="block w-full mt-1 border-gray-300 rounded-md shadow-sm focus:ring-[#424A5C] focus:border-[#424A5C] sm:text-sm p-2 border">
                        <option value="all" <%= status === 'all' ? 'selected' : '' %>>All</option>
                        <option value="normal" <%= status === 'normal' ? 'selected' : '' %>>Normal</option>
                        <option value="throttled" <%= status === 'throttled' ? 'selected' : '' %>>Throttled</option>
                    </select>
                </div>
                <div class="pt-5">
                    <button type="submit" class="bg-[#424A5C] text-white px-4 py-2 rounded shadow hover:bg-[#2D3340] transition text-sm font-medium">Filter</button>
                </div>
            </form>
        </div>

        <div class="bg-white rounded shadow overflow-hidden">
            <table class="w-full text-left">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="p-4 font-semibold text-gray-600">Device ID (Anonymous)</th>
                        <th class="p-4 font-semibold text-gray-600">Bandwidth Consumed (<%= selectedDate %>)</th>
                        <th class="p-4 font-semibold text-gray-600">Throttle Status</th>
                        <th class="p-4 font-semibold text-gray-600">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% devices.forEach(device => { %>
                    <tr class="border-b hover:bg-gray-50 transition">
                        <td class="p-4 font-mono text-sm text-gray-600">
                            <%= device.id %>
                        </td>
                        <td class="p-4 font-bold text-gray-800">
                            <%= device.consumedDisplay %>
                        </td>
                        <td class="p-4">
                            <% if(device.isThrottled) { %>
                                <span class="bg-red-100 text-red-700 px-2 py-1 rounded text-xs font-bold uppercase tracking-wider">Throttled (1 Mbps)</span>
                            <% } else { %>
                                <span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold uppercase tracking-wider">Normal</span>
                            <% } %>
                        </td>
                        <td class="p-4">
                            <form action="/devices/reset/<%= device.id %>?date=<%= selectedDate %>&status=<%= status %>&page=<%= page %>" method="POST">
                                <button type="submit" onclick="return confirm('Reset bandwidth quota for this device on <%= selectedDate %>?');" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1 rounded shadow text-sm font-medium transition">
                                    Reset Quota
                                </button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                    <% if(devices.length === 0) { %>
                        <tr><td colspan="4" class="p-8 text-center text-gray-500 italic">No devices found for the selected criteria.</td></tr>
                    <% } %>
                </tbody>
            </table>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
            <div class="bg-gray-50 px-4 py-3 border-t border-gray-200 flex items-center justify-between sm:px-6">
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing page <span class="font-medium"><%= page %></span> of <span class="font-medium"><%= totalPages %></span>
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <a href="?date=<%= selectedDate %>&status=<%= status %>&page=<%= page > 1 ? page - 1 : 1 %>" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 <%= page === 1 ? 'pointer-events-none opacity-50' : '' %>">
                                <span>Previous</span>
                            </a>

                            <%
                            let startPage = Math.max(1, page - 2);
                            let endPage = Math.min(totalPages, page + 2);

                            if (startPage > 1) { %>
                                <a href="?date=<%= selectedDate %>&status=<%= status %>&page=1" class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">1</a>
                                <% if (startPage > 2) { %>
                                    <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-gray-50 text-sm font-medium text-gray-700">...</span>
                                <% } %>
                            <% } %>

                            <% for(let i = startPage; i <= endPage; i++) { %>
                                <a href="?date=<%= selectedDate %>&status=<%= status %>&page=<%= i %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 <%= page === i ? 'bg-[#424A5C] text-white' : 'bg-white text-gray-700 hover:bg-gray-50' %> text-sm font-medium">
                                    <%= i %>
                                </a>
                            <% } %>

                            <% if (endPage < totalPages) { %>
                                <% if (endPage < totalPages - 1) { %>
                                    <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-gray-50 text-sm font-medium text-gray-700">...</span>
                                <% } %>
                                <a href="?date=<%= selectedDate %>&status=<%= status %>&page=<%= totalPages %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50"><%= totalPages %></a>
                            <% } %>

                            <a href="?date=<%= selectedDate %>&status=<%= status %>&page=<%= page < totalPages ? page + 1 : totalPages %>" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 <%= page === totalPages ? 'pointer-events-none opacity-50' : '' %>">
                                <span>Next</span>
                            </a>
                        </nav>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</body>
</html>