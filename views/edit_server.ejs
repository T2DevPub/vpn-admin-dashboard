<!DOCTYPE html>
<html>
<head>
    <title><%= server ? 'Edit' : 'Add' %> Server | VPN Admin</title>
    <link rel="icon" type="image/png" href="/images/t2vpn_icon.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <nav class="bg-[#424A5C] text-white p-4 flex justify-between items-center shadow">
        <div class="flex items-center space-x-3">
            <img src="/images/t2VPN.png" alt="t2VPN Logo" class="h-8 bg-white p-1 rounded">
            <span class="font-bold text-xl">Admin Dashboard</span>
        </div>
        <a href="/servers" class="bg-[#2D3340] hover:bg-[#1A1F29] px-3 py-1 rounded transition">← Back to Servers</a>
    </nav>

    <div class="p-8 max-w-4xl mx-auto">
        <h1 class="text-2xl font-bold mb-6"><%= server ? 'Edit' : 'Add New' %> Server</h1>

        <form action="/save" method="POST" enctype="multipart/form-data" class="bg-white p-6 rounded shadow">

            <% if(server) { %>
                <input type="hidden" name="id" value="<%= server.id %>">
            <% } %>

            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-gray-700">Country</label>
                    <select name="countryCode" id="countryCodeSelect" class="w-full border rounded p-2 mt-1" required>
                        <option value="">Select a Country...</option>
                        <!-- Options populated by JavaScript -->
                    </select>
                    <!-- Hidden field to auto-populate the display name based on selection -->
                    <input type="hidden" name="name" id="countryNameInput" value="<%= server ? server.name : '' %>">
                </div>
                <div>
                    <label class="block text-gray-700">City</label>
                    <input type="text" name="city" value="<%= server ? server.city : '' %>" class="w-full border rounded p-2 mt-1" required>
                </div>

                <div class="col-span-2 mt-4 p-4 border rounded bg-gray-50">
                    <label class="block text-gray-700 font-bold mb-2">Server Type</label>
                    <div class="flex gap-4">
                        <label class="flex items-center">
                            <input type="radio" name="serverType" value="Standard" class="form-radio h-5 w-5 text-blue-600" <%= (!server || server.serverType !== 'VPNGate') ? 'checked' : '' %> onclick="toggleFields()">
                            <span class="ml-2 text-gray-700">Standard / Own Server</span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="serverType" value="VPNGate" class="form-radio h-5 w-5 text-blue-600" <%= (server && server.serverType === 'VPNGate') ? 'checked' : '' %> onclick="toggleFields()">
                            <span class="ml-2 text-gray-700">VPN Gate (No Auth)</span>
                        </label>
                    </div>
                </div>

                <div id="ipFieldContainer">
                    <label class="block text-gray-700">IP Address / Hostname</label>
                    <input type="text" id="ipAddress" name="ipAddress" value="<%= server ? server.ipAddress : '' %>" class="w-full border rounded p-2 mt-1">
                </div>
                <div id="portFieldContainer">
                    <label class="block text-gray-700">Port (Default: 1194)</label>
                    <input type="number" id="port" name="port" value="<%= server ? server.port : 1194 %>" class="w-full border rounded p-2 mt-1">
                </div>
            </div>

            <div class="mb-4">
                <label class="flex items-center">
                    <input type="checkbox" name="isPlusOnly" class="form-checkbox h-5 w-5 text-blue-600" <%= (server && server.isPlusOnly) ? 'checked' : '' %>>
                    <span class="ml-2 text-gray-700 font-bold">Premium Server (Plus Only)</span>
                </label>
            </div>

            <hr class="my-6">
            <h2 class="text-xl font-bold mb-4">VPN Credentials & Config</h2>

            <div class="grid grid-cols-2 gap-4 mb-4" id="credentialsContainer">
                <div>
                    <label class="block text-gray-700">VPN Username</label>
                    <input type="text" id="vpnUsername" name="vpnUsername" value="<%= server ? server.vpnUsername : '' %>" class="w-full border rounded p-2 mt-1">
                </div>
                <div>
                    <label class="block text-gray-700">VPN Password</label>
                    <input type="text" id="vpnPassword" name="vpnPassword" value="<%= server ? server.vpnPassword : '' %>" class="w-full border rounded p-2 mt-1">
                </div>
            </div>

            <div class="mb-4">
                <label class="block text-gray-700">Upload .ovpn Config File</label>

                <% if(server && server.ovpnConfig) { %>
                    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-3 flex items-center justify-between">
                        <div class="flex items-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            An .ovpn configuration is currently saved for this server.
                        </div>
                        <a href="/admin/download-ovpn/<%= server.id %>" class="bg-green-600 hover:bg-green-700 text-white text-sm font-bold px-3 py-1 rounded shadow inline-flex items-center transition">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            Download
                        </a>
                    </div>
                <% } %>

                <input type="file" name="ovpnFile" accept=".ovpn" class="w-full border rounded p-2 mt-1 bg-gray-50">
                <p class="text-sm text-gray-500 mt-1 mb-4">Uploading a new file will overwrite the existing configuration.</p>

                <label class="flex items-center mt-2">
                    <input type="checkbox" name="skipCertCheck" class="form-checkbox h-5 w-5 text-blue-600" <%= (server && server.skipCertCheck) ? 'checked' : '' %>>
                    <span class="ml-2 text-gray-700 font-bold">Skip Certificate Check (For FastVPN/Auth-only profiles)</span>
                </label>
            </div>

            <!-- Hidden field to keep old config if no new file is uploaded -->
            <input type="hidden" name="existingOvpn" value="<%= server ? server.ovpnConfig : '' %>">

            <div class="mt-8">
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 font-bold">Save Server</button>
            </div>
        </form>
    </div>

    <script>
        function toggleFields() {
            const isVpnGate = document.querySelector('input[name="serverType"]:checked').value === 'VPNGate';
            const ipContainer = document.getElementById('ipFieldContainer');
            const portContainer = document.getElementById('portFieldContainer');
            const credContainer = document.getElementById('credentialsContainer');

            if (isVpnGate) {
                ipContainer.style.display = 'none';
                portContainer.style.display = 'none';
                document.getElementById('ipAddress').removeAttribute('required');
            } else {
                ipContainer.style.display = 'block';
                portContainer.style.display = 'block';
                credContainer.style.display = 'grid';
                document.getElementById('ipAddress').setAttribute('required', 'required');
            }
        }

        // Initialize fields on load
        toggleFields();

        // Full list of ISO 3166-1 alpha-2 country codes and names
        const countries = {
            "AF": "Afghanistan", "AL": "Albania", "DZ": "Algeria", "AD": "Andorra", "AO": "Angola", "AR": "Argentina", "AM": "Armenia", "AU": "Australia", "AT": "Austria", "AZ": "Azerbaijan",
            "BS": "Bahamas", "BH": "Bahrain", "BD": "Bangladesh", "BB": "Barbados", "BY": "Belarus", "BE": "Belgium", "BZ": "Belize", "BJ": "Benin", "BT": "Bhutan", "BO": "Bolivia",
            "BA": "Bosnia and Herzegovina", "BW": "Botswana", "BR": "Brazil", "BN": "Brunei", "BG": "Bulgaria", "BF": "Burkina Faso", "BI": "Burundi", "CV": "Cabo Verde", "KH": "Cambodia",
            "CM": "Cameroon", "CA": "Canada", "CF": "Central African Republic", "TD": "Chad", "CL": "Chile", "CN": "China", "CO": "Colombia", "KM": "Comoros", "CG": "Congo",
            "CR": "Costa Rica", "HR": "Croatia", "CU": "Cuba", "CY": "Cyprus", "CZ": "Czechia", "DK": "Denmark", "DJ": "Djibouti", "DM": "Dominica", "DO": "Dominican Republic",
            "EC": "Ecuador", "EG": "Egypt", "SV": "El Salvador", "GQ": "Equatorial Guinea", "ER": "Eritrea", "EE": "Estonia", "SZ": "Eswatini", "ET": "Ethiopia", "FJ": "Fiji",
            "FI": "Finland", "FR": "France", "GA": "Gabon", "GM": "Gambia", "GE": "Georgia", "DE": "Germany", "GH": "Ghana", "GR": "Greece", "GD": "Grenada", "GT": "Guatemala",
            "GN": "Guinea", "GW": "Guinea-Bissau", "GY": "Guyana", "HT": "Haiti", "HN": "Honduras", "HU": "Hungary", "IS": "Iceland", "IN": "India", "ID": "Indonesia", "IR": "Iran",
            "IQ": "Iraq", "IE": "Ireland", "IL": "Israel", "IT": "Italy", "JM": "Jamaica", "JP": "Japan", "JO": "Jordan", "KZ": "Kazakhstan", "KE": "Kenya", "KI": "Kiribati",
            "KP": "North Korea", "KR": "South Korea", "KW": "Kuwait", "KG": "Kyrgyzstan", "LA": "Laos", "LV": "Latvia", "LB": "Lebanon", "LS": "Lesotho", "LR": "Liberia",
            "LY": "Libya", "LI": "Liechtenstein", "LT": "Lithuania", "LU": "Luxembourg", "MG": "Madagascar", "MW": "Malawi", "MY": "Malaysia", "MV": "Maldives", "ML": "Mali",
            "MT": "Malta", "MH": "Marshall Islands", "MR": "Mauritania", "MU": "Mauritius", "MX": "Mexico", "FM": "Micronesia", "MD": "Moldova", "MC": "Monaco", "MN": "Mongolia",
            "ME": "Montenegro", "MA": "Morocco", "MZ": "Mozambique", "MM": "Myanmar", "NA": "Namibia", "NR": "Nauru", "NP": "Nepal", "NL": "Netherlands", "NZ": "New Zealand",
            "NI": "Nicaragua", "NE": "Niger", "NG": "Nigeria", "MK": "North Macedonia", "NO": "Norway", "OM": "Oman", "PK": "Pakistan", "PW": "Palau", "PA": "Panama",
            "PG": "Papua New Guinea", "PY": "Paraguay", "PE": "Peru", "PH": "Philippines", "PL": "Poland", "PT": "Portugal", "QA": "Qatar", "RO": "Romania", "RU": "Russia",
            "RW": "Rwanda", "KN": "Saint Kitts and Nevis", "LC": "Saint Lucia", "VC": "Saint Vincent and the Grenadines", "WS": "Samoa", "SM": "San Marino", "ST": "Sao Tome and Principe",
            "SA": "Saudi Arabia", "SN": "Senegal", "RS": "Serbia", "SC": "Seychelles", "SL": "Sierra Leone", "SG": "Singapore", "SK": "Slovakia", "SI": "Slovenia", "SB": "Solomon Islands",
            "SO": "Somalia", "ZA": "South Africa", "SS": "South Sudan", "ES": "Spain", "LK": "Sri Lanka", "SD": "Sudan", "SR": "Suriname", "SE": "Sweden", "CH": "Switzerland",
            "SY": "Syria", "TW": "Taiwan", "TJ": "Tajikistan", "TZ": "Tanzania", "TH": "Thailand", "TL": "Timor-Leste", "TG": "Togo", "TO": "Tonga", "TT": "Trinidad and Tobago",
            "TN": "Tunisia", "TR": "Turkey", "TM": "Turkmenistan", "TV": "Tuvalu", "UG": "Uganda", "UA": "Ukraine", "AE": "United Arab Emirates", "GB": "United Kingdom", "US": "United States",
            "UY": "Uruguay", "UZ": "Uzbekistan", "VU": "Vanuatu", "VA": "Vatican City", "VE": "Venezuela", "VN": "Vietnam", "YE": "Yemen", "ZM": "Zambia", "ZW": "Zimbabwe"
        };

        const select = document.getElementById('countryCodeSelect');
        const nameInput = document.getElementById('countryNameInput');

        const existingCode = "<%= server ? server.countryCode : '' %>";

        // Populate dropdown
        for (const [code, name] of Object.entries(countries)) {
            const option = document.createElement('option');
            option.value = code;
            option.textContent = `${name} (${code})`;
            if (code === existingCode) option.selected = true;
            select.appendChild(option);
        }

        // Update hidden name input when dropdown changes
        select.addEventListener('change', (e) => {
            nameInput.value = countries[e.target.value] || "";
        });
    </script>
</body>
</html>
