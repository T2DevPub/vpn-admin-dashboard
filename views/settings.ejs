<!DOCTYPE html>
<html>
<head>
    <title>Settings | VPN Admin</title>
    <link rel="icon" type="image/png" href="/images/t2vpn_icon.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <nav class="bg-[#424A5C] text-white p-4 flex justify-between items-center shadow">
        <div class="flex items-center space-x-3">
            <img src="/images/t2VPN.png" alt="t2VPN Logo" class="h-8 bg-white p-1 rounded">
            <span class="font-bold text-xl">Admin Dashboard</span>
        </div>
        <div>
            <a href="/dashboard" class="mr-4 hover:text-gray-300">Dashboard</a>
            <a href="/servers" class="mr-4 hover:text-gray-300">Servers</a>
            <a href="/ads" class="mr-4 hover:text-gray-300">Ads</a>
            <a href="/settings" class="mr-4 font-bold border-b-2">Settings</a>
            <a href="/logout" class="bg-[#2D3340] hover:bg-[#1A1F29] px-3 py-1 rounded transition">Logout</a>
        </div>
    </nav>

    <div class="p-8 max-w-3xl mx-auto">
        <h1 class="text-2xl font-bold mb-6">App Settings</h1>

        <form action="/settings" method="POST" class="bg-white p-6 rounded shadow">

            <h2 class="text-lg font-bold mb-4 border-b pb-2">Maintenance Mode</h2>

            <div class="space-y-4 mb-6">
                <label class="flex items-center justify-between p-3 border rounded hover:bg-gray-50 cursor-pointer">
                    <div>
                        <span class="text-gray-700 font-bold block">Enable Maintenance Mode</span>
                        <span class="text-gray-500 text-sm">Blocks user access and displays the maintenance screen on the app.</span>
                    </div>
                    <input type="checkbox" name="maintenanceMode" class="form-checkbox h-5 w-5 text-blue-600" <%= settings.maintenanceMode ? 'checked' : '' %>>
                </label>

                <div class="p-3 border rounded">
                    <label class="block text-gray-700 font-bold mb-2">Maintenance End Time</label>
                    <p class="text-gray-500 text-sm mb-2">Optional: Set an expected end time for the maintenance. This will show a countdown in the app.</p>
                    <input type="datetime-local" name="maintenanceEndTime" value="<%= settings.maintenanceEndTime || '' %>" class="w-full border border-gray-300 rounded p-2 focus:ring focus:ring-blue-200 focus:outline-none">
                </div>
            </div>

            <div class="mt-6 flex justify-end">
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 shadow font-bold transition">Save Settings</button>
            </div>
        </form>
    </div>
</body>
</html>